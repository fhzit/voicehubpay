<%
  const order = locals.order || {};
  const units = locals.units || [];
  const payments = locals.payments || [];
  const unitStats = locals.unit_stats || {};
  const totalUnits = Object.values(unitStats).reduce((sum, n) => sum + Number(n ?? 0), 0);
  const isProcessing = order.payment_status === 'paid' && ['success', 'manual_completed'].indexOf(order.fulfillment_status) === -1;
  const modeLabels = { card: '库存卡密', voicehub: 'VoiceHub 发券', card_and_voicehub: '卡密+发券', manual: '人工发货' };
  const item = (order.items && order.items[0]) ? order.items[0] : {};
%>
<div class="container" style="padding-top:24px;">
  <nav class="small muted mb-3"><a href="/account/orders">我的服务</a> › <%= e(order.order_no) %></nav>

  <div class="page-head flex-between flex-wrap">
    <div>
      <h1 class="page-title mono"><%= e(order.order_no) %></h1>
      <p class="page-sub">
        <%- await include('../partials/status-badge', { kind: 'payment', status: order.payment_status }) %>
        <%- await include('../partials/status-badge', { kind: 'fulfillment', status: order.fulfillment_status }) %>
        <span class="small muted">下单于 <%= datetime(order.created_at) %></span>
      </p>
    </div>
    <% if (order.payment_status === 'unpaid') { %>
      <a href="/checkout/<%= e(order.order_no) %>" class="btn btn-primary">去支付</a>
    <% } %>
  </div>

  <% if (isProcessing) { %>
    <div class="notice notice-blue mb-4" data-poll="/api/orders/<%= e(order.order_no) %>/status">
      <strong>正在自动发货…</strong> 支付已确认，系统正在逐张为你发放卡密。请不要关闭此页面，完成后会自动刷新。
      <div class="mt-2 flex" style="gap:14px;flex-wrap:wrap;">
        <span>待处理 <span id="stat-pending"><%= Number(unitStats.pending ?? 0) %></span></span>
        <span>处理中 <span id="stat-processing"><%= Number(unitStats.processing ?? 0) %></span></span>
        <span>已成功 <span id="stat-success"><%= Number(unitStats.success ?? 0) %></span></span>
        <span id="poll-timeout" style="display:none;color:var(--red);font-weight:600;">等待时间较长，可稍后刷新页面查看，卡密会自动保存。</span>
      </div>
      <div class="progress-track mt-3"><div class="progress-fill" id="poll-progress" style="width:0%"></div></div>
    </div>
  <% } %>

  <div class="checkout-grid" style="grid-template-columns:1.2fr .8fr;">
    <div>
      <div class="card">
        <div class="card-header"><h3 class="card-title">卡密 / 发货明细</h3>
          <% if (order.payment_status === 'paid' && units.length > 1 && totalUnits > 0) { %>
            <button class="btn btn-secondary btn-sm" data-reveal-order="<%= e(order.order_no) %>">全部展示</button>
          <% } %>
        </div>

        <% if (order.payment_status !== 'paid') { %>
          <div class="empty" style="padding:32px;">
            <div class="empty-ico">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div class="empty-title">支付后可查看卡密</div>
            <div><a href="/checkout/<%= e(order.order_no) %>" class="btn btn-primary btn-sm">去支付</a></div>
          </div>
        <% } else { %>
          <div class="code-list">
            <% for (const entry of units) { const u = entry.unit || {}; %>
              <div class="code-item">
                <div style="min-width:0;">
                  <div class="small muted mono"><%= e(u.unit_no) %>
                    <% if (u.voicehub_code_ciphertext) { %>· VoiceHub<% } %>
                  </div>
                  <div class="mono" id="code-box-<%= Number(u.id) %>">
                    <% if (u.delivery_code_ciphertext !== null && u.delivery_code_ciphertext !== undefined) { %>
                      <span id="mask-<%= Number(u.id) %>"><%= e(entry.masked) %></span>
                    <% } else if (['failed', 'manual_review'].indexOf(u.status) !== -1) { %>
                      <span style="color:var(--red);font-size:13px;">发货失败，请联系客服处理</span>
                    <% } else { %>
                      <span class="faint" style="font-size:13px;">发放中…</span>
                    <% } %>
                  </div>
                  <% if (u.voicehub_status) { %>
                    <div class="mt-1"><%- await include('../partials/status-badge', { kind: 'voicehub', status: u.voicehub_status }) %></div>
                  <% } %>
                </div>
                <div class="flex">
                  <% if (u.delivery_code_ciphertext !== null && u.delivery_code_ciphertext !== undefined) { %>
                    <button class="btn btn-ghost btn-sm copy-btn" data-copy-unit="<%= Number(u.id) %>">复制</button>
                    <button class="btn btn-primary btn-sm" data-reveal-unit="<%= Number(u.id) %>">查看</button>
                  <% } %>
                </div>
              </div>
            <% } %>
            <% if (units.length === 0) { %>
              <div class="empty"><div class="empty-title">暂无明细</div></div>
            <% } %>
          </div>
          <div class="hint mt-3">卡密仅在支付后展示，请妥善保存，请勿泄露给他人。</div>
        <% } %>
      </div>
    </div>

    <div>
      <div class="card">
        <h3 class="card-title mb-3">订单信息</h3>
        <div class="summary-row"><span class="muted">商品</span><span><%= e(item.product_name_snapshot || '') %></span></div>
        <div class="summary-row"><span class="muted">单价</span><span>¥<%= money(Number(item.product_price_cents_snapshot ?? 0)) %></span></div>
        <div class="summary-row"><span class="muted">数量</span><span><%= Number(item.quantity ?? 0) %></span></div>
        <div class="summary-row"><span class="muted">发货方式</span><span><%= e(modeLabels[item.delivery_mode_snapshot] || '自动发货') %></span></div>
        <div class="summary-row total"><span>应付金额</span><span style="color:var(--red);">¥<%= money(Number(order.amount_due_cents ?? 0)) %></span></div>
        <% if (order.payment_status === 'paid') { %>
          <div class="summary-row"><span class="muted">实付金额</span><span>¥<%= money(Number(order.amount_paid_cents ?? 0)) %></span></div>
          <div class="summary-row"><span class="muted">支付时间</span><span class="small"><%= datetime(order.paid_at) %></span></div>
        <% } %>
      </div>

      <% if (payments.length > 0) { %>
        <div class="card">
          <h3 class="card-title mb-3">支付流水</h3>
          <% for (const pt of payments) { %>
            <div class="flex-between" style="padding:6px 0;border-bottom:1px solid var(--border);">
              <div>
                <div class="small mono"><%= e(pt.pay_type) %></div>
                <div class="small muted"><%= datetime(pt.created_at) %></div>
              </div>
              <div class="text-right">
                <div class="small">¥<%= money(Number(pt.amount_cents ?? 0)) %></div>
                <%- await include('../partials/status-badge', { kind: 'payment', status: pt.status }) %>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>
