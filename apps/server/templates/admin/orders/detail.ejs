<%
  const modeLabels = { card: '库存卡密', voicehub: 'VoiceHub 发券', card_and_voicehub: '卡密+发券', manual: '人工发货' };
  const item = (order.items && order.items[0]) || {};
  const orderNo = e(order.order_no);
  const orderCancelled = order.order_status === 'cancelled' || (order.payment_status !== 'paid' && order.expires_at && String(order.expires_at) < new Date().toISOString());
  const modalForm = (id, title, action, fields, submitLabel = '确认', extraNote = '', variant = 'primary') => {
    let inner = `<input type="hidden" name="_csrf" value="${e(csrf)}">`;
    for (const f of fields) {
      const type = f.type || 'text';
      const required = f.required ? 'required' : '';
      const label = f.label ? `<label class="label">${f.label}${f.required ? ' *' : ''}</label>` : '';
      if (type === 'hidden') {
        inner += `<input type="hidden" name="${f.name}" value="${f.value !== undefined ? f.value : ''}">`;
        continue;
      }
      if (type === 'checkbox') {
        inner += `<div class="field checkbox-row"><input type="checkbox" name="${f.name}" id="${id}-${f.name}" value="${f.value || '1'}"><label for="${id}-${f.name}" class="small muted">${f.label || ''}</label></div>`;
        continue;
      }
      inner += `<div class="field">${label}`;
      if (type === 'textarea') {
        inner += `<textarea class="textarea" name="${f.name}" rows="${f.rows || 3}" ${required} placeholder="${f.placeholder || ''}">${f.value || ''}</textarea>`;
      } else {
        inner += `<input class="input" type="${type}" name="${f.name}" value="${f.value || ''}" ${required} placeholder="${f.placeholder || ''}"${type === 'password' ? ' autocomplete="new-password"' : ''}>`;
      }
      inner += '</div>';
    }
    const alert = variant === 'danger'
      ? '<div class="alert alert-warning" style="margin:16px 22px 0;"><strong>危险操作</strong> —— 此操作将修改订单状态并记录审计日志，请确认原因后执行。</div>'
      : '';
    const btnCls = variant === 'danger' ? 'btn-danger' : 'btn-primary';
    return `<div class="modal-backdrop" id="${id}"><div class="modal">`
      + `<div class="modal-header"><h3 class="modal-title">${title}</h3><button class="modal-close" data-modal-close>×</button></div>`
      + alert
      + `<form method="post" action="${action}">${inner}<div class="modal-actions"><button class="btn btn-secondary" type="button" data-modal-close>取消</button><button class="btn ${btnCls}">${submitLabel}</button></div></form>`
      + (extraNote ? `<div class="hint">${extraNote}</div>` : '')
      + '</div></div>';
  };
%>
<div class="filters">
  <a href="/admin/orders" class="btn btn-ghost btn-sm">← 返回列表</a>
  <span class="muted mono"><%= e(order.order_no) %></span>
  <% if (orderCancelled) { %>
    <span class="badge badge-gray">已取消</span>
  <% } else { %>
    <%- include('../../partials/status-badge', { kind: 'payment', status: order.payment_status }) %>
    <%- include('../../partials/status-badge', { kind: 'fulfillment', status: order.fulfillment_status }) %>
  <% } %>
  <span class="badge badge-<%= order.source === 'afdian' ? 'purple' : 'blue' %>"><%= order.source === 'afdian' ? '爱发电' : '商城' %></span>
  <div class="flex-1"></div>
  <% if (order.payment_status !== 'paid') { %>
    <button class="btn btn-danger btn-sm" data-modal-open="modal-cancel">取消订单</button>
  <% } %>
  <button class="btn btn-primary btn-sm" data-modal-open="modal-manual">手动处理</button>
</div>

<div class="grid" style="grid-template-columns:1fr 340px;align-items:start;">
  <div>
    <div class="card">
      <div class="card-header"><h3 class="card-title">发货单元</h3>
        <div class="flex" style="gap:6px;flex-wrap:wrap;">
          <% if (order.payment_status === 'paid') { %>
            <button class="btn btn-secondary btn-sm" data-modal-open="modal-process">处理待发货</button>
            <button class="btn btn-secondary btn-sm" data-modal-open="modal-retry">重试失败</button>
            <button class="btn btn-purple btn-sm" data-modal-open="modal-complete">整体人工完成</button>
          <% } %>
        </div>
      </div>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>单元</th><th>状态</th><th>VoiceHub</th><th>卡密（掩码）</th><th>错误</th><th class="text-right">操作</th></tr></thead>
        <tbody>
        <% if (units.length === 0) { %><tr><td colspan="6" class="text-center muted">暂无发货单元</td></tr><% } %>
        <% units.forEach((u) => { %>
          <tr>
            <td class="mono small"><%= e(u.unit.unit_no) %></td>
            <td><%- include('../../partials/status-badge', { kind: 'fulfillment', status: u.unit.status }) %></td>
            <td><%- include('../../partials/status-badge', { kind: 'voicehub', status: u.unit.voicehub_status }) %></td>
            <td class="mono small"><%= e(u.code_masked || '—') %></td>
            <td class="small" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= e(u.unit.voicehub_last_error || '') %>"><%= e(u.unit.voicehub_last_error || '') %></td>
            <td class="text-right">
              <% if (u.unit.voicehub_status !== 'success' && order.payment_status === 'paid') { %>
                <button class="btn btn-ghost btn-sm" data-modal-open="modal-retry-unit" data-unit-id="<%= Number(u.unit.id) %>">重试</button>
              <% } %>
              <% if (['failed', 'pending', 'processing', 'manual_review'].includes(u.unit.status)) { %>
                <button class="btn btn-ghost btn-sm" data-modal-open="modal-assign" data-unit-id="<%= Number(u.unit.id) %>">分配</button>
                <button class="btn btn-ghost btn-sm" data-modal-open="modal-unit-complete" data-unit-id="<%= Number(u.unit.id) %>">标记完成</button>
              <% } %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    </div>

    <div class="card">
      <h3 class="card-title mb-3">订单信息</h3>
      <div class="grid" style="grid-template-columns:1fr 1fr;gap:8px 20px;">
        <div class="summary-row"><span class="muted">用户</span><span><%= e(user ? user.username : '—') %><% if (user) { %> <a class="small" href="/admin/users/<%= Number(user.id) %>">详情</a><% } %></span></div>
        <div class="summary-row"><span class="muted">商品</span><span><%= e(item.product_name_snapshot || '') %> × <%= Number(item.quantity || 0) %></span></div>
        <div class="summary-row"><span class="muted">单价快照</span><span>¥<%= money(Number(item.product_price_cents_snapshot || 0)) %></span></div>
        <div class="summary-row"><span class="muted">发货方式</span><span><%= e(modeLabels[item.delivery_mode_snapshot] || '—') %></span></div>
        <div class="summary-row"><span class="muted">应付</span><span>¥<%= money(Number(order.amount_due_cents || 0)) %></span></div>
        <div class="summary-row"><span class="muted">实付</span><span>¥<%= money(Number(order.amount_paid_cents || 0)) %></span></div>
        <div class="summary-row"><span class="muted">创建时间</span><span class="small"><%= datetime(order.created_at) %></span></div>
        <div class="summary-row"><span class="muted">支付时间</span><span class="small"><%= datetime(order.paid_at) %></span></div>
      </div>
      <% if (order.payment_status === 'paid' && ['card', 'card_and_voicehub'].includes(item.delivery_mode_snapshot)) { %>
        <div class="hint mt-3">当前商品可售库存：<strong><%= inventory_available %></strong> 张 <a href="/admin/inventory?product=<%= Number(item.product_id) %>">查看库存 →</a></div>
      <% } %>
    </div>

    <% if (payments.length > 0) { %>
      <div class="card">
        <h3 class="card-title mb-3">支付流水</h3>
        <% payments.forEach((pt) => { %>
          <div class="flex-between" style="padding:8px 0;border-bottom:1px solid var(--border);">
            <div>
              <span class="badge badge-blue"><%= e(pt.pay_type) %></span>
              <span class="small muted ml-2 mono"><%= e(pt.merchant_order_no || '') %></span>
            </div>
            <div class="flex" style="gap:10px;">
              <span class="small">¥<%= money(Number(pt.amount_cents || 0)) %></span>
              <%- include('../../partials/status-badge', { kind: 'payment', status: pt.status }) %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="card">
      <h3 class="card-title mb-3">相关操作日志</h3>
      <% if (recent_audit.length === 0) { %><div class="muted small">暂无日志</div><% } %>
      <% recent_audit.forEach((log) => { %>
        <div class="flex-between" style="padding:6px 0;border-bottom:1px solid var(--border);">
          <div class="small"><code class="inline"><%= e(log.action) %></code> <span class="muted"><%= e(log.username || '') %></span></div>
          <div class="small muted"><%= datetime(log.created_at) %></div>
        </div>
      <% }) %>
    </div>
  </div>

  <div>
    <div class="card">
      <h3 class="card-title mb-3">手动处理</h3>
      <div class="grid" style="gap:8px;">
        <button class="btn btn-secondary btn-block" data-modal-open="modal-query">查询 SG65 支付状态</button>
        <button class="btn btn-danger btn-block" data-modal-open="modal-manual-confirm" <%= order.payment_status === 'paid' ? 'disabled' : '' %>>人工确认付款（需密码）</button>
        <% if (order.payment_status === 'paid') { %>
          <button class="btn btn-secondary btn-block" data-modal-open="modal-assign-inv" <%= inventory_available <= 0 ? 'disabled' : '' %>>为缺失单元分配库存</button>
        <% } %>
        <button class="btn btn-ghost btn-block" data-modal-open="modal-delete-unpaid" <%= order.payment_status === 'paid' ? 'disabled' : '' %>>取消未付款订单</button>
      </div>
      <div class="hint mt-3">高风险操作需要填写原因并写入操作日志；人工确认付款需验证管理员密码。</div>
    </div>

    <div class="card">
      <h3 class="card-title mb-3">VoiceHub 最近推送</h3>
      <% const deliveries = units.filter((u) => u.delivery); %>
      <% if (deliveries.length === 0) { %><div class="muted small">暂无推送记录</div><% } %>
      <% deliveries.forEach((u) => { %>
        <div class="small" style="padding:6px 0;border-bottom:1px solid var(--border);">
          <div class="flex-between"><span class="mono"><%= e(u.delivery.source_order_no) %></span><%- include('../../partials/status-badge', { kind: 'delivery', status: u.delivery.status }) %></div>
          <div class="muted mt-1">码：<%= e(u.delivery_masked) %> · 尝试 <%= Number(u.delivery.attempts || 0) %> 次</div>
          <% if (u.delivery.last_error) { %><div class="small" style="color:var(--red);"><%= e(u.delivery.last_error) %></div><% } %>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<%- modalForm('modal-query', '查询 SG65 支付状态', '/admin/orders/query-payment', [
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'note', type: 'textarea', label: '说明（可选）', placeholder: '主动查询支付平台当前状态' },
], '查询', '仅查询不产生任何修改；若平台返回已支付，将自动入账并发货。') %>

<%- modalForm('modal-manual-confirm', '人工确认付款', '/admin/orders/manual-confirm', [
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'reason', type: 'textarea', label: '处理原因', required: true, placeholder: '例如：用户已线下转账，凭证已核对' },
  { name: 'admin_password', type: 'password', label: '管理员密码（二次验证）', required: true },
], '确认入账并开始发货', `将订单标记为已支付 ¥${money(Number(order.amount_due_cents || 0))}，并触发自动发货。`, 'danger') %>

<%- modalForm('modal-cancel', '取消订单', '/admin/orders/cancel', [
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'reason', type: 'textarea', label: '取消原因', required: true, placeholder: '例如：用户放弃支付' },
], '取消订单并释放库存', '', 'danger') %>

<%- modalForm('modal-process', '处理待发货', '/admin/orders/process', [
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'note', type: 'textarea', label: '说明（可选）', placeholder: '对全部待发货单元逐个调用 VoiceHub' },
], '开始处理', '逐个单元调用 VoiceHub，每次一个 code，绝不批量。') %>

<%- modalForm('modal-retry', '重试失败单元', '/admin/orders/retry-failed', [
  { name: 'order_no', type: 'hidden', value: orderNo },
], '重试') %>

<%- modalForm('modal-complete', '整体标记人工完成', '/admin/orders/complete', [
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'reason', type: 'textarea', label: '处理原因', required: true, placeholder: '例如：全部线下发放完毕' },
], '确认完成', '', 'danger') %>

<%- modalForm('modal-assign-inv', '分配库存', '/admin/orders/assign-inventory', [
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'reason', type: 'textarea', label: '处理原因', required: true, placeholder: '例如：用户付款后库存卡密缺失，补发' },
], '分配并开始发货', `将从商品可售库存中取卡分配给缺失单元并触发发货。当前可售：${inventory_available} 张`) %>

<%- modalForm('modal-delete-unpaid', '取消未付款订单', '/admin/orders/delete-unpaid', [
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'reason', type: 'textarea', label: '处理原因', required: true, placeholder: '例如：超时未支付' },
], '确认', '', 'danger') %>

<%- modalForm('modal-retry-unit', '重试该单元', '/admin/orders/retry-unit', [
  { name: 'unit_id', type: 'hidden', value: '' },
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'reason', type: 'textarea', label: '强制重推原因（可选）', placeholder: '仅强制重推需填写' },
  { name: 'force', type: 'checkbox', label: '强制重新推送（会重复调用 VoiceHub）', value: '1' },
], '执行重试', '普通重试会复用原 code；若已成功过则需勾选强制重推。') %>

<%- modalForm('modal-unit-complete', '标记单元完成', '/admin/orders/unit-complete', [
  { name: 'unit_id', type: 'hidden', value: '' },
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'reason', type: 'textarea', label: '处理原因', required: true, placeholder: '例如：线下已交付' },
], '确认', '', 'danger') %>

<%- modalForm('modal-assign', '人工分配卡密', '/admin/orders/assign-code', [
  { name: 'unit_id', type: 'hidden', value: '' },
  { name: 'order_no', type: 'hidden', value: orderNo },
  { name: 'code', type: 'textarea', label: '卡密内容', required: true, placeholder: '输入要发给用户的卡密' },
  { name: 'reason', type: 'textarea', label: '处理原因', required: true, placeholder: '例如：线下手动发卡' },
], '保存卡密', '卡密将加密存储，仅以掩码展示。') %>

<script>
  (function () {
    document.querySelectorAll('[data-modal-open][data-unit-id]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-unit-id');
        var modal = document.getElementById(btn.getAttribute('data-modal-open'));
        if (!modal) return;
        var field = modal.querySelector('input[name="unit_id"]');
        if (field) field.value = id;
      });
    });
  })();
</script>
