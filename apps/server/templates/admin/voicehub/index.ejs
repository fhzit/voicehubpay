<%
  const f = filters;
  const sourceLabels = { inventory: '库存卡密', shop_order_no: '商城订单号', afdian_order_no: '爱发电订单号' };
  const pageHref = (i) => {
    const params = new URLSearchParams();
    Object.entries(f).forEach(([key, value]) => { if (value !== '' && value !== undefined && value !== null) params.set(key, String(value)); });
    params.set('page', String(i));
    return `/admin/voicehub?${params.toString()}`;
  };
%>
<div class="stat-grid" style="margin-bottom:16px;grid-template-columns:repeat(4,1fr);">
  <div class="stat-card"><div class="stat-label">总请求</div><div class="stat-value"><%= Number(stats.total || 0) %></div></div>
  <div class="stat-card"><div class="stat-label">成功</div><div class="stat-value" style="color:var(--green);"><%= Number(stats.success || 0) %></div></div>
  <div class="stat-card"><div class="stat-label">失败</div><div class="stat-value" style="color:var(--red);"><%= Number(stats.failed || 0) %></div></div>
  <div class="stat-card"><div class="stat-label">今日请求</div><div class="stat-value"><%= Number(stats.today || 0) %></div></div>
</div>

<div class="filters">
  <form method="get" action="/admin/voicehub" class="flex" style="gap:10px;flex-wrap:wrap;flex:1;">
    <input type="text" name="q" class="input search" placeholder="订单号/来源单号" value="<%= e(f.q || '') %>">
    <select name="status" class="select">
      <option value="">全部状态</option>
      <% [['success', '成功'], ['failed', '失败'], ['processing', '处理中'], ['pending', '待处理'], ['not_required', '无需推送']].forEach(([sk, sl]) => { %>
        <option value="<%= sk %>" <%= (f.status || '') === sk ? 'selected' : '' %>><%= sl %></option>
      <% }) %>
    </select>
    <select name="code_source" class="select">
      <option value="">全部来源</option>
      <% Object.entries(sourceLabels).forEach(([sk, sl]) => { %>
        <option value="<%= sk %>" <%= (f.code_source || '') === sk ? 'selected' : '' %>><%= sl %></option>
      <% }) %>
    </select>
    <button class="btn btn-secondary">筛选</button>
  </form>
  <a href="/admin/voicehub/failures" class="btn btn-danger">失败中心 (<%= Number(stats.failed || 0) %>)</a>
</div>

<div class="card card-pad-0">
  <div class="table-wrap"><table class="table">
    <thead><tr><th>ID</th><th>来源单号</th><th>来源</th><th>状态</th><th>尝试</th><th>错误</th><th>时间</th><th></th></tr></thead>
    <tbody>
    <% if (deliveries.length === 0) { %>
      <tr><td colspan="8" class="text-center muted">暂无推送记录</td></tr>
    <% } %>
    <% deliveries.forEach((d) => { %>
      <tr>
        <td class="small mono faint">#<%= Number(d.id) %></td>
        <td class="mono small"><%= e(d.source_order_no) %></td>
        <td class="small"><%= e(sourceLabels[d.code_source] || d.code_source) %></td>
        <td><%- await include('../../partials/status-badge', { kind: 'delivery', status: d.status }) %></td>
        <td><%= Number(d.attempts || 0) %></td>
        <td class="small" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= e(d.last_error || '') %>"><%= e(d.last_error || '') %></td>
        <td class="small muted"><%= datetime(d.updated_at) %></td>
        <td>
          <% if (d.status === 'failed') { %>
            <form method="post" action="/admin/voicehub/retry">
              <input type="hidden" name="_csrf" value="<%= e(csrf) %>">
              <input type="hidden" name="delivery_id" value="<%= Number(d.id) %>">
              <button class="btn btn-secondary btn-sm">重试</button>
            </form>
          <% } else { %><span class="small faint">—</span><% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</div>

<%- await include('../../partials/pagination', { page, pages, href: pageHref }) %>
