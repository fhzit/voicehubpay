<%
  const pageHref = (i) => `/admin/afdian?status=${encodeURIComponent(status)}&voicehub=${encodeURIComponent(voicehub)}&q=${encodeURIComponent(q)}&page=${i}`;
%>
<div class="page-head flex-between flex-wrap">
  <div><h1 class="page-title">爱发电订单</h1></div>
  <form method="post" action="/admin/afdian/sync">
    <input type="hidden" name="_csrf" value="<%= e(csrf) %>">
    <button class="btn btn-primary">手动同步</button>
  </form>
</div>

<div class="stat-grid" style="margin-bottom:16px;grid-template-columns:repeat(4,1fr);">
  <div class="stat-card"><div class="stat-label">累计营收</div><div class="stat-value">¥<%= money(Number(stats.sum || 0)) %></div></div>
  <div class="stat-card"><div class="stat-label">今日订单</div><div class="stat-value"><%= Number(stats.today_orders || 0) %></div></div>
  <div class="stat-card"><div class="stat-label">VoiceHub 已成功</div><div class="stat-value" style="color:var(--green);"><%= Number((stats.voicehub || {}).success || 0) %></div></div>
  <div class="stat-card"><div class="stat-label">VoiceHub 失败</div><div class="stat-value" style="color:var(--red);"><%= Number((stats.voicehub || {}).failed || 0) %></div></div>
</div>

<div class="filters">
  <form method="get" action="/admin/afdian" class="flex" style="gap:10px;flex-wrap:wrap;flex:1;">
    <input type="text" name="q" class="input search" placeholder="订单号/买家" value="<%= e(q) %>">
    <select name="status" class="select">
      <option value="">全部支付状态</option>
      <% [['paid', '已支付'], ['unpaid', '未支付'], ['pending', '处理中']].forEach(([sk, sl]) => { %>
        <option value="<%= sk %>" <%= status === sk ? 'selected' : '' %>><%= sl %></option>
      <% }) %>
    </select>
    <select name="voicehub" class="select">
      <option value="">全部推送状态</option>
      <% [['success', '已成功'], ['failed', '失败'], ['pending', '待推送']].forEach(([sk, sl]) => { %>
        <option value="<%= sk %>" <%= voicehub === sk ? 'selected' : '' %>><%= sl %></option>
      <% }) %>
    </select>
    <button class="btn btn-secondary">筛选</button>
  </form>
</div>

<div class="card card-pad-0">
  <div class="table-wrap"><table class="table">
    <thead><tr><th>订单号</th><th>买家</th><th>备注</th><th class="num">金额</th><th>推送</th><th>尝试</th><th>时间</th><th></th></tr></thead>
    <tbody>
    <% if (orders.length === 0) { %>
      <tr><td colspan="8" class="text-center muted">暂无爱发电订单</td></tr>
    <% } %>
    <% orders.forEach((o) => { %>
      <tr>
        <td class="mono"><%= e(o.out_trade_no) %></td>
        <td class="small"><%= e(o.buyer_name || '') %></td>
        <td class="small muted"><%= e(o.remark || '') %></td>
        <td class="num">¥<%= money(Number(o.amount_cents || 0)) %></td>
        <td><%- include('../../partials/status-badge', { kind: 'voicehub', status: o.voicehub_status }) %></td>
        <td><%= Number(o.voicehub_attempts || 0) %></td>
        <td class="small muted"><%= datetime(o.created_at) %></td>
        <td>
          <% if (o.status === 'paid' && o.voicehub_status !== 'success') { %>
            <form method="post" action="/admin/afdian/retry">
              <input type="hidden" name="_csrf" value="<%= e(csrf) %>">
              <input type="hidden" name="out_trade_no" value="<%= e(o.out_trade_no) %>">
              <button class="btn btn-secondary btn-sm">重试</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</div>

<%- include('../../partials/pagination', { page, pages, href: pageHref }) %>
