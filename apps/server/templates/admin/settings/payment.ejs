<%
  const g = (k, d = '') => (settings[k] === undefined || settings[k] === null ? d : String(settings[k]));
  const types = g('SG65_ENABLED_TYPES', 'alipay,wxpay,qqpay').split(',').filter((entry) => entry !== '');
  const epayTypes = g('EPAY_V2_ENABLED_TYPES', 'alipay,wxpay').split(',').filter((x) => x !== '');
  const epayV1Types = g('EPAY_V1_ENABLED_TYPES', 'alipay,wxpay').split(',').filter((x) => x !== '');
  const PAY_TYPES = [['alipay', '支付宝'], ['wxpay', '微信支付'], ['qqpay', 'QQ 钱包']];
%>
<div class="settings-layout settings-layout-single">
<div class="settings-column" style="min-width:0;">
<div class="settings-section" style="max-width:840px;">
  <h3 class="card-title mb-2">SG65 聚合支付（V2 · RSA SHA256WithRSA）</h3>
  <p class="muted small mb-4">仅支持 V2 签名（SHA256WithRSA），不支持 V1 MD5。密钥经主密钥加密保存，界面仅显示掩码。</p>

  <form method="post" action="/admin/settings/payment">
    <input type="hidden" name="_csrf" value="<%= e(csrf) %>">
    <div class="field checkbox-row">
      <input type="checkbox" name="sg65_enabled" id="sg65_enabled" value="1" <%= g('SG65_ENABLED', '0') === '1' ? 'checked' : '' %>>
      <label for="sg65_enabled" class="small muted">启用 SG65 支付</label>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">商户 PID</label>
        <input class="input" type="text" name="sg65_pid" required value="<%= e(g('SG65_PID')) %>">
      </div>
      <div class="field">
        <label class="label">默认支付方式</label>
        <select name="sg65_default_type" class="select">
          <% PAY_TYPES.forEach(([tk, tl]) => { %>
            <option value="<%= tk %>" <%= g('SG65_DEFAULT_PAYMENT_TYPE', 'alipay') === tk ? 'selected' : '' %>><%= tl %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="field">
      <label class="label">启用支付方式</label>
      <div class="flex-wrap flex" style="gap:12px;">
        <% PAY_TYPES.forEach(([tk, tl]) => { %>
          <div class="checkbox-row">
            <input type="checkbox" name="sg65_types[]" id="type_<%= tk %>" value="<%= tk %>" <%= types.includes(tk) ? 'checked' : '' %>>
            <label for="type_<%= tk %>" class="small"><%= tl %></label>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="field">
      <label class="label">请求方式</label>
      <select name="sg65_default_method" class="select">
        <option value="jump" <%= g('SG65_DEFAULT_METHOD', 'jump') === 'jump' ? 'selected' : '' %>>跳转支付（生成支付地址跳转）</option>
        <option value="web" <%= g('SG65_DEFAULT_METHOD', 'jump') === 'web' ? 'selected' : '' %>>内嵌收银台（网页支付）</option>
      </select>
    </div>
    <div class="field">
      <label class="label">商户私钥（RSA 私钥 PEM）</label>
      <textarea class="textarea" name="sg65_merchant_private_key" rows="5" placeholder="<%= private_key_configured ? '••••••••' : '-----BEGIN RSA PRIVATE KEY-----…' %>"></textarea>
      <div class="hint"><%= private_key_configured ? '当前已配置。留空或输入掩码表示不修改。' : '尚未配置，保存后加密存储。' %></div>
    </div>
    <div class="field">
      <label class="label">平台公钥（SG65 平台 RSA 公钥 PEM）</label>
      <textarea class="textarea" name="sg65_platform_public_key" rows="5" placeholder="<%= public_key_configured ? '••••••••' : '-----BEGIN PUBLIC KEY-----…' %>"></textarea>
      <div class="hint">用于校验 SG65 通知签名。<%= public_key_configured ? '当前已配置，留空表示不修改。' : '尚未配置。' %></div>
    </div>

    <div class="field">
      <label class="label">回调地址（在 SG65 商户后台填写）</label>
      <div class="small"><code class="inline">异步通知：</code><code class="inline mono"><%= e(notify_url) %></code></div>
      <div class="small mt-1"><code class="inline">同步跳转：</code><code class="inline mono"><%= e(return_url) %></code></div>
    </div>

    <div class="form-grid">
      <div class="field">
        <label class="label">商城手续费率（%）</label>
        <input class="input" type="number" name="shop_fee_percent" min="0" max="100" step="0.1" value="<%= e(g('SHOP_FEE_PERCENT', '3')) %>">
        <div class="hint">商城订单的实际收入按此比例扣除，默认 3%。</div>
      </div>
      <div class="field">
        <label class="label">本通道手续费（%）</label>
        <input class="input" type="number" name="channel_fee_percent" min="0" max="100" step="0.01" value="<%= e(g('PAY_CHANNEL_SG65_FEE_PERCENT', '0')) %>">
        <div class="hint">向买家额外收取，按商品原价叠加计算。</div>
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">通道显示名称</label>
        <input class="input" type="text" name="channel_name" maxlength="32" value="<%= e(g('PAY_CHANNEL_SG65_NAME')) %>" placeholder="易付通（SG65）">
      </div>
      <div class="field">
        <label class="label">通道备注（展示给用户）</label>
        <input class="input" type="text" name="channel_remark" maxlength="120" value="<%= e(g('PAY_CHANNEL_SG65_REMARK')) %>" placeholder="例如：实时到账">
      </div>
    </div>

    <div class="flex">
      <button class="btn btn-primary">保存支付设置</button>
      <button class="btn btn-secondary" type="button" id="test-sg65">测试连接</button>
    </div>
  </form>
</div>

<div class="settings-section" style="max-width:840px;margin-top:20px;">
  <h3 class="card-title mb-2">易支付（V1 页面支付 + V2 接口支付）</h3>
  <p class="muted small mb-4">
    同一家易支付商户可同时开启两种协议：V1 走 <code class="inline mono"><%= e(locals.epay_v1_submit_url || 'https://666.hboqy.cn/xpay/epay/submit.php') %></code> 页面支付（MD5）；
    V2 走 <code class="inline mono"><%= e(locals.epay_submit_url || 'https://666.hboqy.cn/xpay/epayn/api/pay/submit') %></code> 接口支付（RSA-SHA256）。
    两者可各自独立启用，收银台会按启用情况展示给用户选择。
  </p>

  <form method="post" action="/admin/settings/payment/epay">
    <input type="hidden" name="_csrf" value="<%= e(csrf) %>">

    <h4 class="small" style="font-weight:650;margin:6px 0 10px;">V2 · 接口支付（RSA-SHA256）</h4>
    <div class="field checkbox-row">
      <input type="checkbox" name="epay_enabled" id="epay_enabled" value="1" <%= g('EPAY_V2_ENABLED', '0') === '1' ? 'checked' : '' %>>
      <label for="epay_enabled" class="small muted">启用 V2 渠道</label>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">对接地址（Base URL）</label>
        <input class="input" type="text" name="epay_base_url" value="<%= e(g('EPAY_V2_BASE_URL', 'https://666.hboqy.cn/xpay/epayn')) %>" placeholder="https://666.hboqy.cn/xpay/epayn">
        <div class="hint">可只填到 /xpay/epayn，系统自动补全 /api/pay/submit。</div>
      </div>
      <div class="field">
        <label class="label">商户 ID（pid）</label>
        <input class="input" type="text" name="epay_pid" value="<%= e(g('EPAY_V2_PID')) %>">
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">商户私钥（RSA）</label>
        <input class="input" type="text" name="epay_merchant_private_key" value="" placeholder="<%= locals.epay_private_configured ? '已配置（留空则不修改）' : '未配置' %>" autocomplete="off">
      </div>
      <div class="field">
        <label class="label">平台公钥（RSA）</label>
        <input class="input" type="text" name="epay_platform_public_key" value="" placeholder="<%= locals.epay_public_configured ? '已配置（留空则不修改）' : '未配置' %>" autocomplete="off">
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">默认支付方式</label>
        <select name="epay_default_type" class="select">
          <% PAY_TYPES.forEach(([tk, tl]) => { %>
            <option value="<%= tk %>" <%= g('EPAY_V2_DEFAULT_TYPE', 'alipay') === tk ? 'selected' : '' %>><%= tl %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label class="label">启用的支付方式</label>
        <div class="flex" style="gap:12px;flex-wrap:wrap;">
          <% PAY_TYPES.forEach(([tk, tl]) => { %>
            <label class="small muted flex" style="gap:6px;align-items:center;">
              <input type="checkbox" name="epay_types" value="<%= tk %>" <%= epayTypes.includes(tk) ? 'checked' : '' %>><%= tl %>
            </label>
          <% }) %>
        </div>
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">V2 显示名称</label>
        <input class="input" type="text" name="epay_v2_channel_name" maxlength="32" value="<%= e(g('PAY_CHANNEL_EPAYV2_NAME')) %>" placeholder="易支付V2">
      </div>
      <div class="field">
        <label class="label">V2 手续费（%）</label>
        <input class="input" type="number" name="epay_v2_channel_fee_percent" min="0" max="100" step="0.01" value="<%= e(g('PAY_CHANNEL_EPAYV2_FEE_PERCENT', '0')) %>">
        <div class="hint">向买家额外收取，按商品原价叠加计算。</div>
      </div>
    </div>
    <div class="field">
      <label class="label">V2 备注（展示给用户）</label>
      <input class="input" type="text" name="epay_v2_channel_remark" maxlength="120" value="<%= e(g('PAY_CHANNEL_EPAYV2_REMARK')) %>" placeholder="例如：支持花呗分期">
    </div>
    <div class="field">
      <label class="label">V2 回调地址（填到易支付后台）</label>
      <div class="small mono"><%= e(locals.epay_notify_url || '') %></div>
      <div class="small mono muted"><%= e(locals.epay_return_url || '') %></div>
    </div>

    <h4 class="small" style="font-weight:650;margin:22px 0 10px;padding-top:16px;border-top:1px solid var(--border);">V1 · 页面支付（MD5）</h4>
    <div class="field checkbox-row">
      <input type="checkbox" name="epay_v1_enabled" id="epay_v1_enabled" value="1" <%= g('EPAY_V1_ENABLED', '0') === '1' ? 'checked' : '' %>>
      <label for="epay_v1_enabled" class="small muted">启用 V1 渠道</label>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">对接地址（Base URL）</label>
        <input class="input" type="text" name="epay_v1_base_url" value="<%= e(g('EPAY_V1_BASE_URL', 'https://666.hboqy.cn/xpay/epay')) %>" placeholder="https://666.hboqy.cn/xpay/epay">
        <div class="hint">可只填到 /xpay/epay（或 /xpay），系统自动补全 /submit.php。</div>
      </div>
      <div class="field">
        <label class="label">商户 ID（pid）</label>
        <input class="input" type="text" name="epay_v1_pid" value="<%= e(g('EPAY_V1_PID')) %>">
      </div>
    </div>
    <div class="field">
      <label class="label">商户密钥（MD5 Key）</label>
      <input class="input" type="text" name="epay_v1_key" value="" placeholder="<%= locals.epay_v1_key_configured ? '已配置（留空则不修改）' : '未配置' %>" autocomplete="off">
      <div class="hint">用于 V1 页面支付与异步通知的 MD5 签名，与 V2 的 RSA 密钥互不影响。签名默认小写 MD5（彩虹易支付标准）；若网关要求大写，设置环境变量 <code class="inline mono">EPAY_V1_SIGN_CASE=upper</code>。</div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">默认支付方式</label>
        <select name="epay_v1_default_type" class="select">
          <% PAY_TYPES.forEach(([tk, tl]) => { %>
            <option value="<%= tk %>" <%= g('EPAY_V1_DEFAULT_TYPE', 'alipay') === tk ? 'selected' : '' %>><%= tl %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label class="label">启用的支付方式</label>
        <div class="flex" style="gap:12px;flex-wrap:wrap;">
          <% PAY_TYPES.forEach(([tk, tl]) => { %>
            <label class="small muted flex" style="gap:6px;align-items:center;">
              <input type="checkbox" name="epay_v1_types" value="<%= tk %>" <%= epayV1Types.includes(tk) ? 'checked' : '' %>><%= tl %>
            </label>
          <% }) %>
        </div>
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">V1 显示名称</label>
        <input class="input" type="text" name="epay_v1_channel_name" maxlength="32" value="<%= e(g('PAY_CHANNEL_EPAYV1_NAME')) %>" placeholder="易支付V1（页面支付）">
      </div>
      <div class="field">
        <label class="label">V1 手续费（%）</label>
        <input class="input" type="number" name="epay_v1_channel_fee_percent" min="0" max="100" step="0.01" value="<%= e(g('PAY_CHANNEL_EPAYV1_FEE_PERCENT', '0')) %>">
        <div class="hint">向买家额外收取，按商品原价叠加计算。</div>
      </div>
    </div>
    <div class="field">
      <label class="label">V1 备注（展示给用户）</label>
      <input class="input" type="text" name="epay_v1_channel_remark" maxlength="120" value="<%= e(g('PAY_CHANNEL_EPAYV1_REMARK')) %>" placeholder="例如：跳转收银台，支持大额">
    </div>
    <div class="field">
      <label class="label">V1 回调地址（填到易支付后台）</label>
      <div class="small mono"><%= e(locals.epay_v1_notify_url || '') %></div>
      <div class="small mono muted"><%= e(locals.epay_v1_return_url || '') %></div>
    </div>

    <div class="flex">
      <button class="btn btn-primary">保存易支付设置</button>
      <button class="btn btn-secondary" type="button" id="test-epay">测试 V2 密钥与连通性</button>
    </div>
  </form>
</div>

<script>
  (function () {
    var btn = document.getElementById('test-epay');
    if (!btn) return;
    btn.addEventListener('click', function () {
      btn.disabled = true; btn.textContent = '测试中…';
      var body = new URLSearchParams(); body.set('_csrf', '<%= e(csrf) %>');
      fetch('/admin/settings/payment/epay-test', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
        .then(function (r) { return r.json(); })
        .then(function (j) { alert((j.ok ? '通过：' : '失败：') + JSON.stringify(j.checks ? { checks: j.checks, error: j.error } : j.error)); btn.disabled = false; btn.textContent = '测试 V2 密钥与连通性'; })
        .catch(function () { alert('请求失败'); btn.disabled = false; btn.textContent = '测试 V2 密钥与连通性'; });
    });
  })();
</script>

<script>
  (function () {
    var btn = document.getElementById('test-sg65');
    if (!btn) return;
    btn.addEventListener('click', function () {
      btn.disabled = true;
      btn.textContent = '测试中…';
      var fd = new URLSearchParams();
      fd.set('_csrf', '<%= e(csrf) %>');
      fetch('/admin/settings/payment/test', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: fd })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          alert(j.ok ? '连接成功：' + JSON.stringify(j.data) : '失败：' + j.error);
          btn.disabled = false;
          btn.textContent = '测试连接';
        })
        .catch(function () { alert('网络错误'); btn.disabled = false; btn.textContent = '测试连接'; });
    });
  })();
</script>
</div></div>
