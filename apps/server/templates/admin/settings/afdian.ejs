<% const g = (k, d = '') => (settings[k] === undefined || settings[k] === null ? d : String(settings[k])); %>
<div class="settings-layout settings-layout-single">
<div class="settings-column" style="min-width:0;">
<div class="settings-section" style="max-width:840px;">
  <h3 class="card-title mb-2">爱发电对接</h3>
  <p class="muted small mb-4">所有入口（Webhook / 轮询 / 后台同步 / 重试）统一经过 AfdianOrderProcessor，<strong>out_trade_no 始终作为 VoiceHub code</strong>，成功不重复推送。</p>

  <form method="post" action="/admin/settings/afdian">
    <input type="hidden" name="_csrf" value="<%= e(csrf) %>">
    <div class="field checkbox-row">
      <input type="checkbox" name="afdian_enabled" id="afdian_enabled" value="1" <%= g('AFDIAN_ENABLED', '0') === '1' ? 'checked' : '' %>>
      <label for="afdian_enabled" class="small muted">启用爱发电对接</label>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">爱发电 User ID</label>
        <input class="input" type="text" name="afdian_user_id" value="<%= e(g('AFDIAN_USER_ID')) %>">
      </div>
      <div class="field">
        <label class="label">API Token</label>
        <input class="input" type="text" name="afdian_api_token" value="" placeholder="<%= e(token_placeholder) %>" autocomplete="off">
        <div class="hint"><%= token_placeholder ? '已配置，留空表示不修改。' : 'Token 加密存储。' %></div>
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">API 地址</label>
        <input class="input" type="text" name="afdian_api_base" value="<%= e(g('AFDIAN_API_BASE', 'https://ifdian.net')) %>">
      </div>
      <div class="field">
        <label class="label">订单接口路径</label>
        <input class="input" type="text" name="afdian_order_endpoint" value="<%= e(g('AFDIAN_ORDER_ENDPOINT', '/api/open/query-order')) %>">
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">单次轮询订单上限</label>
        <input class="input" type="number" name="afdian_poll_limit" min="1" value="<%= Number(g('AFDIAN_POLL_LIMIT', '20')) %>">
      </div>
      <div class="field">
        <label class="label">每页数量</label>
        <input class="input" type="number" name="afdian_poll_per_page" min="1" max="100" value="<%= Number(g('AFDIAN_POLL_PER_PAGE', '50')) %>">
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label">爱发电手续费率（%）</label>
        <input class="input" type="number" name="afdian_fee_percent" min="0" max="100" step="0.1" value="<%= e(g('AFDIAN_FEE_PERCENT', '6')) %>">
        <div class="hint">爱发电订单的实际收入按此比例扣除，默认 6%。</div>
      </div>
    </div>
    <div class="field checkbox-row">
      <input type="checkbox" name="afdian_poll_enabled" id="afdian_poll_enabled" value="1" <%= g('AFDIAN_POLL_ENABLED', '1') === '1' ? 'checked' : '' %>>
      <label for="afdian_poll_enabled" class="small muted">启用订单轮询（关闭后只依赖 Webhook 通知，建议关闭）</label>
    </div>
    <div class="field checkbox-row">
      <input type="checkbox" name="afdian_require_signature" id="afdian_require_signature" value="1" <%= g('AFDIAN_WEBHOOK_REQUIRE_SIGNATURE', '1') === '1' ? 'checked' : '' %>>
      <label for="afdian_require_signature" class="small muted">校验 Webhook 请求签名（RSA）</label>
    </div>
    <div class="field">
      <label class="label">Webhook 地址（在爱发电后台填写）</label>
      <div class="flex" style="gap:8px;">
        <code class="inline mono" id="afdian-webhook" style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= e(webhook_url) %></code>
      </div>
      <div class="hint">最近 Webhook：<%= datetime(last_webhook) %> · 最近轮询：<%= datetime(last_poll) %></div>
    </div>
    <div class="flex">
      <button class="btn btn-primary">保存设置</button>
      <button class="btn btn-secondary" type="button" id="test-afdian">测试 API</button>
    </div>
  </form>
</div>

<script>
  (function () {
    var btn = document.getElementById('test-afdian');
    if (!btn) return;
    btn.addEventListener('click', function () {
      btn.disabled = true;
      btn.textContent = '测试中…';
      var fd = new URLSearchParams();
      fd.set('_csrf', '<%= e(csrf) %>');
      fetch('/admin/settings/afdian/test', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: fd })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          alert(j.ok ? '连接成功，返回 ' + j.orders_returned + ' 条订单' : '失败：' + j.error);
          btn.disabled = false;
          btn.textContent = '测试 API';
        })
        .catch(function () { alert('网络错误'); btn.disabled = false; btn.textContent = '测试 API'; });
    });
  })();
</script>
</div></div>
