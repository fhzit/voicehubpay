# voicehubpay normally stores runtime settings in storage/settings.sqlite via /setup.
# Copy this file to .env only when you intentionally need environment-level defaults.

APP_ENV=local
APP_URL=http://127.0.0.1:8080

# Optional fallback for order data storage before Web UI setup is saved.
# DATA_DB_CONNECTION=sqlite
# DATA_DB_DATABASE=storage/voicehubpay.sqlite
# DATA_DB_CONNECTION=pgsql
# DATA_DB_HOST=127.0.0.1
# DATA_DB_PORT=5432
# DATA_DB_DATABASE=voicehubpay
# DATA_DB_USERNAME=voicehubpay
# DATA_DB_PASSWORD=secret
