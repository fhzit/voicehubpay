# VoiceHubPay 环境变量（可选覆盖层）
#
# 安装/运行配置主要由 /install 向导写入 storage/settings.sqlite。
# 仅当你需要环境级覆盖时，复制本文件为 .env（会被 .gitignore 忽略）。
# .env 中的值优先于 settings.sqlite 中的同键值。

APP_ENV=production
# 必须与站点真实地址一致（用于生成 SG65/QQ/微信回调地址）
APP_URL=https://your-domain.example

# 业务数据库（不配置时 /install 会要求选择 SQLite 或 PostgreSQL）
DATA_DB_CONNECTION=sqlite
DATA_DB_DATABASE=storage/voicehubpay.sqlite
# DATA_DB_CONNECTION=pgsql
# DATA_DB_HOST=127.0.0.1
# DATA_DB_PORT=5432
# DATA_DB_DATABASE=voicehubpay
# DATA_DB_USERNAME=voicehubpay
# DATA_DB_PASSWORD=secret

# 站点默认时区（Dashboard 周期统计）
APP_TIMEZONE=Asia/Shanghai

# 未支付订单保留分钟数（之后库存预留被释放）
# ORDER_TTL_MINUTES=30

# 维护模式（true 时前台停机，/install 与支付/爱发电回调除外）
# MAINTENANCE_MODE=false
