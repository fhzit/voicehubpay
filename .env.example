APP_ENV=local
APP_URL=http://127.0.0.1:8080
APP_KEY=change-me-to-a-long-random-secret

DB_CONNECTION=sqlite
DB_DATABASE=storage/voicehubpay.sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=voicehubpay
# DB_USERNAME=voicehubpay
# DB_PASSWORD=secret

OAUTH_CLIENT_ID=voicehubpay
OAUTH_CLIENT_SECRET=change-me
OAUTH_AUTHORIZE_URL=https://example.com/oauth/authorize
OAUTH_TOKEN_URL=https://example.com/oauth/token
OAUTH_USERINFO_URL=https://example.com/oauth/userinfo
OAUTH_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
OAUTH_SCOPES=openid profile email
OAUTH_ALLOWED_EMAILS=

AFDIAN_USER_ID=change-me
AFDIAN_TOKEN=change-me
AFDIAN_WEBHOOK_SECRET=change-me
AFDIAN_API_BASE=https://afdian.com/api/open
AFDIAN_POLL_PAGE_SIZE=50

VOICEHUB_API_BASE=https://voicehub.example.com
VOICEHUB_API_TOKEN=change-me
VOICEHUB_TICKET_ENDPOINT=/api/song-tickets
VOICEHUB_DEFAULT_TICKET_AMOUNT=1
